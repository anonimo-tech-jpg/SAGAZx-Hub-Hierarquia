local SavePath          = "saved_skins.json"

--==============================================================
-- 📦 ESTRUTURA DE DADOS
--==============================================================
-- LastSlot   = maior slot já usado (nunca diminui)
-- FreeSlots  = lista de slots livres (deletados) para reaproveitar
-- Skins      = { [nome] = slot }

local function GetDefaultData()
    return {
        LastSlot  = 25, -- próximo slot novo será 26
        FreeSlots = {}, -- pilha de slots reaproveitáveis
        Skins     = {}
    }
end

--==============================================================
-- 💾 PERSISTÊNCIA
--==============================================================
local function LoadSkinsData()
    if isfile and isfile(SavePath) then
        local success, result = pcall(function()
            return HttpService:JSONDecode(readfile(SavePath))
        end)
        if success and type(result) == "table" and result.Skins then
            -- Migração: garante campos novos em JSONs antigos
            if type(result.LastSlot) ~= "number" then
                result.LastSlot = 25
            end
            if type(result.FreeSlots) ~= "table" then
                result.FreeSlots = {}
            end
            return result
        end
    end
    return GetDefaultData()
end

local function SaveSkinsData(data)
    if writefile then
        pcall(function()
            writefile(SavePath, HttpService:JSONEncode(data))
        end)
    end
end

-- Tabela em memória
local SkinData = LoadSkinsData()

--==============================================================
-- 🛠️ HELPERS DE SLOT
--==============================================================

-- Pega um slot: primeiro tenta reaproveitar os livres, senão cria novo
local function AcquireSlot()
    table.sort(SkinData.FreeSlots) -- mantém ordem estável (menor primeiro)
    local slot = table.remove(SkinData.FreeSlots, 1)
    if slot then
        return slot
    end
    SkinData.LastSlot = SkinData.LastSlot + 1
    return SkinData.LastSlot
end

-- Devolve um slot à lista de livres
local function ReleaseSlot(slot)
    if type(slot) ~= "number" then return end
    -- Evita duplicar na lista
    for _, s in ipairs(SkinData.FreeSlots) do
        if s == slot then return end
    end
    table.insert(SkinData.FreeSlots, slot)
    table.sort(SkinData.FreeSlots)
end

--==============================================================
-- 🛠️ HELPERS DE LISTA
--==============================================================
local function GetSkinNames()
    local names = {}
    for name, _ in pairs(SkinData.Skins) do
        table.insert(names, name)
    end
    table.sort(names)
    return names
end

