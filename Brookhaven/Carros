-- Botão dentro da Redz Lib que injeta o "Freio Avião" na GUI do veículo
-- O botão nasce no meio da parte inferior e pode ser arrastado

local player = game:GetService("Players").LocalPlayer

-- ===== Proteção contra execução repetida =====
local genv = getgenv() or _G
if genv.__FreioAviaoLoaded then
	return
end
genv.__FreioAviaoLoaded = true

local IMAGE_ID = "rbxassetid://132697572297978"

-- ===== Função que freia =====
local function frear()
	local character = player.Character
	if not character then return end

	local alvo = character
	local pai = character.Parent
	while pai and not pai:IsA("Model") do
		pai = pai.Parent
	end
	if pai and pai.PrimaryPart then
		alvo = pai
	end

	task.spawn(function()
		local fim = os.clock() + 0.5
		while os.clock() < fim do
			if alvo:IsA("BasePart") then
				alvo.AssemblyLinearVelocity = Vector3.zero
				alvo.AssemblyAngularVelocity = Vector3.zero
			end
			if alvo.PrimaryPart then
				alvo.PrimaryPart.AssemblyLinearVelocity = Vector3.zero
				alvo.PrimaryPart.AssemblyAngularVelocity = Vector3.zero
			end
			task.wait()
		end
	end)
end

-- ===== Cria o botão de freio (arrastável) =====
local function criarBotaoFreio()
	local playerGui = player:WaitForChild("PlayerGui")

	local mainGui = playerGui:WaitForChild("MainGUIHandler")
	local vehicleControls = mainGui:WaitForChild("VehicleControls")
	local controlsFrame = vehicleControls:WaitForChild("Controls")

	-- Remove botão antigo, se existir
	local antigo = controlsFrame:FindFirstChild("FreioaviaoButton")
	if antigo then
		antigo:Destroy()
	end

	local botao = Instance.new("ImageButton")
	botao.Name = "FreioaviaoButton"
	botao.Size = UDim2.new(0, 60, 0, 60)
	-- Nasce no meio da parte inferior do frame
	botao.AnchorPoint = Vector2.new(0.5, 1)
	botao.Position = UDim2.new(0.5, 0, 1, -10)
	botao.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
	botao.BackgroundTransparency = 0.15
	botao.Image = IMAGE_ID
	botao.ScaleType = Enum.ScaleType.Fit
	botao.Parent = controlsFrame

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = botao

	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 3
	stroke.Color = Color3.fromRGB(255, 255, 255)
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = botao

	-- ===== Arrastar dentro do frame =====
	local dragging = false
	local dragStart = nil
	local startPos = nil
	local dragConnection = nil

	botao.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = botao.Position

			if dragConnection then dragConnection:Disconnect() end
			dragConnection = input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)

	game:GetService("UserInputService").InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStart
			botao.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + delta.X,
				startPos.Y.Scale, startPos.Y.Offset + delta.Y
			)
		end
	end)

	botao.MouseButton1Click:Connect(frear)
	botao.TouchTap:Connect(frear)

	return botao
end

-- ===== Botão na Redz Lib =====
Tab7:AddButton({
	Name = "Freio Avião (Injetar no Veículo)",
	Callback = function()
		pcall(criarBotaoFreio)
	end
})

-- Botão na Redz Lib: levanta o jogador (se sentado) e ativa o boost
-- Brookhaven

local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local player            = Players.LocalPlayer

-- ===== 1) Se estiver sentado, levanta primeiro =====
local function unseatIfSitting()
	local character = player.Character
	if not character then return end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then return end

	if humanoid.Sit or humanoid.SeatPart then
		pcall(function()
			humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
		end)

		humanoid.Sit = false
		task.wait(0.3)

		pcall(function()
			humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
		end)
	end
end

-- ===== 2) Ativa o boost =====
local function activateBoost()
	-- Método 1: VehicleController.SetBoost
	pcall(function()
		local VehicleController = require(ReplicatedStorage.Modules.Client.Vehicles.VehicleController)
		VehicleController.SetBoost(true)
	end)

	-- Método 2: Forçar unlock + SetBoost
	pcall(function()
		local UnlockableController = require(ReplicatedStorage.Modules.Client.PlayerData.UnlockableController)
		local AdFeatures = require(ReplicatedStorage.Modules.Shared.Advertisements.AdFeatures)
		local BOOST_ID = AdFeatures.VEHICLE_BOOST.id

		local original = UnlockableController.IsFeatureUnlocked
		UnlockableController.IsFeatureUnlocked = function(id, ...)
			if id == BOOST_ID then return true end
			return original(id, ...)
		end

		local VehicleController = require(ReplicatedStorage.Modules.Client.Vehicles.VehicleController)
		VehicleController.SetBoost(true)
	end)

	-- Método 3: Simular clique no botão de boost
	pcall(function()
		local playerGui = player:WaitForChild("PlayerGui")
		local boostGui = playerGui:FindFirstChild("VehicleBoost")
			or playerGui:FindFirstChild("VehicleBoost", true)
		if not boostGui then return end

		local boostBtn = boostGui:FindFirstChild("BoostButton")
			or boostGui:FindFirstChild("BoostButton", true)
		if not boostBtn then return end

		if getconnections then
			for _, conn in ipairs(getconnections(boostBtn.MouseButton1Down)) do
				pcall(conn.Function)
			end
		elseif firesignal then
			firesignal(boostBtn.MouseButton1Down)
		end
	end)
end

-- ===== Executa na ordem =====
local function executarBoost()
	unseatIfSitting()
	activateBoost()
end

-- ===== Botão na Redz Lib =====
Tab7:AddButton({
	Name = "Boost Free ",
	Callback = function()
		pcall(executarBoost)
	end
})

