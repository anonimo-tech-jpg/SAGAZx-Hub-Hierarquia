                                        if troot.Velocity.Magnitude > 0 then
                                            local pos = troot.Position + (troot.Velocity / 1.5)
                                            Ball.CFrame = CFrame.new(pos)
                                            Ball.Orientation += Vector3.new(45, 60, 30)
                                        else
                                            for _, v in pairs(tchar:GetChildren()) do
                                                if v:IsA("BasePart") and v.CanCollide and not v.Anchored then
                                                    Ball.CFrame = v.CFrame
                                                    break
                                                end
                                            end
                                        end
                                    else
                                        break
                                    end
                                end

                                pcall(function()
                                    bv:Destroy()
                                    Ball.CFrame = CFrame.new(0, -500, 0)
                                end)
                            end
                        end
                    end
                end
            end)

            -- Bloco centralizado de limpeza garantida em caso de sucesso ou erro
            pcall(function()
                if selectedMethod == "ônibus" then
                    pcall(function()
                        Remotes:WaitForChild("1Ca1r"):FireServer("DeleteAllVehicles")
                    end)
                end
                local char = LocalPlayer.Character
                if char then
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    if hum then
                        hum.Sit = false
                    end
                end
            end)

            if not success and err then
                warn("[SAGAZx] Erro na execução do Fling: ", err)
            end

            isFlinging = false
        end)
    end
})

