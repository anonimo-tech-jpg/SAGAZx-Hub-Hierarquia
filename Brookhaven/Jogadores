-- Persistência organizada por método compatível com SagazObjectSelection.json
local SAVE_FILE = "SagazObjectSelection.json"
local HttpService = game:GetService("HttpService")

local function LoadSavedData()
    local success, result = pcall(function()
        if isfile(SAVE_FILE) then
            return HttpService:JSONDecode(readfile(SAVE_FILE))
        end
    end)
    if success and type(result) == "table" then
        return result.method, result.objects
    end
    return nil, nil
end

local savedMethod, savedObjectsMap = LoadSavedData()
if not savedObjectsMap then
    savedObjectsMap = {}
end

local function SaveSelections()
    pcall(function()
        local data = {
            method = selectedMethod,
            objects = savedObjectsMap,
            object = selectedObject
        }
        writefile(SAVE_FILE, HttpService:JSONEncode(data))
    end)
end

