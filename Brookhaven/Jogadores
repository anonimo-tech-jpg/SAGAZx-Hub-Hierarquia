local dropdownObjectRef = nil

local function GetObjectNames(methodName)
    local list = {}
    if ObjectConfig[methodName] then
        for _, obj in ipairs(ObjectConfig[methodName]) do
            table.insert(list, obj.Name)
        end
    end
    return list
end

if savedMethod and ObjectConfig[savedMethod] then
    selectedMethod = savedMethod
else
    selectedMethod = "ônibus"
end

local function GetBestObjectForMethod(methodName)
    local available = GetObjectNames(methodName)
    if #available == 0 then return nil end
    
    if savedObjectsMap and savedObjectsMap[methodName] then
        local savedName = savedObjectsMap[methodName]
        for _, name in ipairs(available) do
            if name == savedName then
                return savedName
            end
        end
    end
    
    return available[1]
end

selectedObject = GetBestObjectForMethod(selectedMethod)
if savedObjectsMap then
    savedObjectsMap[selectedMethod] = selectedObject
end

Tab3:AddDropdown({
    Name = "Método",
    Options = { "ônibus", "sofa", "prop", "bola" },
    Default = selectedMethod,
    Callback = function(Value)
        selectedMethod = Value
        local newOptions = GetObjectNames(Value)
        
        selectedObject = GetBestObjectForMethod(Value)
        if selectedObject and savedObjectsMap then
            savedObjectsMap[Value] = selectedObject
        end
        
        if dropdownObjectRef and dropdownObjectRef.Set then
            dropdownObjectRef:Set(newOptions)
        end
        SaveSelections()
    end
})

dropdownObjectRef = Tab3:AddDropdown({
    Name = "Selecionar Objeto",
    Options = GetObjectNames(selectedMethod),
    Default = selectedObject,
    Callback = function(Value)
        if Value and Value ~= "" then
            selectedObject = Value
            if selectedMethod then
                if not savedObjectsMap then savedObjectsMap = {} end
                savedObjectsMap[selectedMethod] = Value
            end
            SaveSelections()
        end
    end
})

