local function GetCurrentObjectConfig()
    if not selectedMethod or not selectedObject then return nil end
    local list = ObjectConfig[selectedMethod]
    if not list then return nil end
    for _, obj in ipairs(list) do
        if obj.Name == selectedObject then
            return obj
        end
    end
    return list[1]
end

